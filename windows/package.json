{
  "name": "termpet-windows",
  "productName": "TermPet",
  "version": "0.5.1",
  "description": "텀펫 윈도우판 — Claude Code·Codex·터미널 작업이 끝나면 알려주는 데스크톱 펫",
  "author": "TermPet",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "npm run build && npm run koffi:win && electron-builder --win nsis --x64",
    "koffi:win": "node scripts/fetch-koffi-win.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
